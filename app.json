{
  "expo": {
    "name": "Expo PWA",
    "slug": "expo-pwa",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "expopwa",
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./public/icons/app-icon.svg"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
